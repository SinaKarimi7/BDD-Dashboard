# GitHub OAuth Configuration
# Create a GitHub OAuth App at https://github.com/settings/developers
# Authorization callback URL is always the API host + /api/github/callback.
#   dev:     http://localhost:5173/api/github/callback
#   docker:  http://localhost:3000/api/github/callback
#   split:   https://<project>.vercel.app/api/github/callback
# PORT is optional. Default: 3000.
# HOST is optional. Default: 0.0.0.0. Used by npm start.
# API_ONLY is optional. Default: unset, the process serves the site and the callback. Set 1 to skip files.
# This file is optional. With Docker, PORT is the host port and the process listens on 3000 inside the container.
# If a variable is unset here, Compose uses the environment variable of the same name.

# GitHub OAuth App Client ID (public, sent to the browser). Required for OAuth.
# Docker reads this when the container starts. A static host bakes it at build time.
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# Same client id, read only by the server. Required for OAuth.
GITHUB_CLIENT_ID=your_github_client_id_here

# GitHub OAuth App Client Secret. Server only. Required for OAuth.
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Where the browser loads /api/github/callback.
# Empty means the site's own origin. Set this for GitHub Pages + Vercel.
# No default host.
VITE_API_ORIGIN=

# Where the API sends the browser after OAuth.
# Empty means a relative redirect on the API host. Set this to the Pages origin.
# No default host.
APP_ORIGIN=
