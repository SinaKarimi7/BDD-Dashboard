# Required for "Connect with GitHub OAuth". There are no defaults.
# These three variables only enable that button.
#
# Create an OAuth App:
# https://github.com/settings/developers → OAuth Apps → New OAuth App
# Authorization callback URL: https://<your-vercel-host>/api/github/callback
# That route is api/github/callback.ts. It runs on Vercel Serverless Function. `npm run dev` does not serve it.

# Public client id. Backed into the browser bundle.
VITE_GITHUB_CLIENT_ID=your_github_oauth_app_client_id

# Same client id (public), read only by the callback. 
GITHUB_CLIENT_ID=your_github_oauth_app_client_id

# OAuth App client secret. Server only.
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
